{
  "name": "billing",
  "apps": {
    "gateway": {
      "ingress": {
        "external": true,
        "target_port": 3000,
        "transport": "http2",
        "allow_insecure": false
      },
      "replicas": {
        "min": 1,
        "max": 3
      },
      "containers": {
        "web": {
          "cpu": 0.5,
          "memory": "1Gi",
          "env": {},
          "secrets": [],
          "docker": {
            "file": "./web/Dockerfile"
          }
        },
        "proxy": {
          "cpu": 0.25,
          "memory": "0.5Gi",
          "env": {
            "MODE": "sidecar"
          },
          "secrets": [],
          "image": "nginx:1.27"
        }
      }
    }
  },
  "databases": {
    "main": {
      "type": "sqlserver",
      "size": "medium",
      "storage_gb": 32,
      "public_access": false,
      "dbs": [
        "main"
      ],
      "external": false
    }
  },
  "database_legacy": true
}
