{
  "name": "orders-api",
  "component": "worker",
  "apps": {
    "worker": {
      "replicas": {
        "min": 1,
        "max": 3
      },
      "containers": {
        "main": {
          "cpu": 0.5,
          "memory": "1Gi",
          "env": {},
          "secrets": []
        }
      }
    }
  },
  "databases": {
    "main": {
      "type": "postgres",
      "size": "small",
      "storage_gb": 32,
      "public_access": false,
      "external": true,
      "dbs": [
        "main"
      ]
    }
  },
  "database_legacy": true
}
