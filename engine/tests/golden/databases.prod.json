{
  "name": "shop",
  "apps": {
    "api": {
      "ingress": {
        "external": false,
        "target_port": 8080,
        "transport": "auto",
        "allow_insecure": false
      },
      "replicas": {
        "min": 1,
        "max": 3
      },
      "containers": {
        "main": {
          "cpu": 0.5,
          "memory": "1Gi",
          "env": {},
          "secrets": []
        }
      },
      "databases": [
        "primary/orders",
        "reporting/main"
      ]
    },
    "worker": {
      "replicas": {
        "min": 1,
        "max": 3
      },
      "containers": {
        "main": {
          "cpu": 0.5,
          "memory": "1Gi",
          "env": {},
          "secrets": []
        }
      },
      "databases": [
        "primary/orders",
        "primary/billing"
      ]
    }
  },
  "functions": {
    "sync": {
      "env": {},
      "secrets": [],
      "image": "myacr.azurecr.io/sync:1.0",
      "databases": [
        "reporting/main"
      ]
    }
  },
  "databases": {
    "primary": {
      "type": "postgres",
      "size": "medium",
      "storage_gb": 32,
      "public_access": false,
      "dbs": [
        "orders",
        "billing"
      ],
      "external": false
    },
    "reporting": {
      "type": "sqlserver",
      "size": "large",
      "storage_gb": 32,
      "public_access": false,
      "dbs": [
        "main"
      ],
      "external": false
    }
  }
}
