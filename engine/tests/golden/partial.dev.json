{
  "name": "partial",
  "functions": {
    "relay": {
      "env": {},
      "secrets": [],
      "image": "myacr.azurecr.io/relay:2.0"
    }
  },
  "static_sites": {
    "docs": {
      "env": {}
    }
  },
  "apps": {
    "main": {
      "ingress": {
        "external": false,
        "target_port": 5000,
        "transport": "http2",
        "allow_insecure": false
      },
      "replicas": {
        "min": 2,
        "max": 3
      },
      "containers": {
        "main": {
          "cpu": 0.5,
          "memory": "1Gi",
          "env": {},
          "secrets": []
        }
      }
    }
  },
  "databases": {
    "main": {
      "type": "postgres",
      "size": "large",
      "storage_gb": 32,
      "public_access": false,
      "dbs": [
        "main"
      ]
    }
  },
  "database_legacy": true
}
