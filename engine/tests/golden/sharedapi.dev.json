{
  "name": "shop",
  "component": "api",
  "databases": {
    "primary": {
      "type": "postgres",
      "size": "small",
      "storage_gb": 32,
      "public_access": false,
      "external": true,
      "dbs": [
        "orders",
        "billing"
      ]
    }
  },
  "storage": {
    "containers": [],
    "public_access": false,
    "external": true
  },
  "apps": {
    "main": {
      "ingress": {
        "external": false,
        "target_port": 8080,
        "transport": "auto",
        "allow_insecure": false
      },
      "replicas": {
        "min": 1,
        "max": 3
      },
      "containers": {
        "main": {
          "cpu": 0.5,
          "memory": "1Gi",
          "env": {},
          "secrets": []
        }
      },
      "databases": [
        "primary/orders"
      ]
    }
  }
}
