.terraform/
*.tfstate
*.tfstate.*
crash.log

__pycache__/
.pytest_cache
.ruff_cache
.coverage
coverage.xml
htmlcov/

# sonar-scanner local run artifacts
.scannerwork/

# Caller-supplied terraform staged into the custom module at deploy time.
# Only the platform's _-prefixed files belong in the repo. _versions.tf
# declares only required_version (no required_providers, to avoid a
# duplicate required_providers block once _providers.g.tf is generated).
terraform/azure/custom/*
!terraform/azure/custom/_context.tf
!terraform/azure/custom/_versions.tf

# Brainstorming visual companion sessions
.superpowers/

# Per-machine hook state: absolute paths, session ids, edit counts. Regenerates
# on demand. .impeccable/config.json next to it IS shared and stays tracked.
.impeccable/hook.cache.json
