{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vgmello/cloud-app/terraform/schema/cloud-app.schema.json",
  "title": "cloud-app manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "anyOf": [
    {
      "required": [
        "app"
      ]
    },
    {
      "required": [
        "apps"
      ]
    },
    {
      "required": [
        "functions"
      ]
    },
    {
      "required": [
        "static_sites"
      ]
    }
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,29}$"
    },
    "app": {
      "$ref": "#/$defs/app"
    },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,29}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/app"
      }
    },
    "functions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,29}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/function"
      }
    },
    "static_sites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,29}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/static_site"
      }
    },
    "database": {
      "$ref": "#/$defs/database"
    },
    "databases": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,29}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/database"
      }
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "deploy": {
      "$ref": "#/$defs/deploy"
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]{1,15}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/overlay"
      }
    },
    "terraform": {
      "$ref": "#/$defs/custom_terraform"
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,29}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ingress": {
          "oneOf": [
            {
              "enum": [
                "public",
                "internal",
                "none"
              ]
            },
            {
              "$ref": "#/$defs/ingress"
            }
          ]
        },
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?Gi$"
        },
        "replicas": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "context": {
              "type": "string"
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "containers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,29}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/container"
          }
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "databases": {
          "$ref": "#/$defs/db_refs"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "containers"
            ]
          },
          "then": {
            "properties": {
              "cpu": false,
              "memory": false,
              "docker": false,
              "env": false,
              "secrets": false,
              "image": false
            }
          }
        },
        {
          "not": {
            "required": [
              "image",
              "docker"
            ]
          }
        }
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,29}$"
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "context": {
              "type": "string"
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "databases": {
          "$ref": "#/$defs/db_refs"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "dotnet-isolated:8.0",
            "dotnet-isolated:9.0",
            "node:20",
            "node:22",
            "python:3.11",
            "python:3.12",
            "java:17",
            "java:21",
            "powershell:7.4"
          ]
        },
        "package": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "image",
              "docker"
            ]
          }
        },
        {
          "not": {
            "required": [
              "image",
              "package"
            ]
          }
        },
        {
          "not": {
            "required": [
              "docker",
              "package"
            ]
          }
        },
        {
          "if": {
            "required": [
              "package"
            ]
          },
          "then": {
            "required": [
              "runtime"
            ]
          }
        },
        {
          "if": {
            "required": [
              "runtime"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "image"
                ]
              },
              {
                "required": [
                  "docker"
                ]
              },
              {
                "required": [
                  "package"
                ]
              }
            ]
          }
        }
      ]
    },
    "static_site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,29}$"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "postgres",
            "sqlserver"
          ]
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "storage_gb": {
          "type": "integer",
          "minimum": 32,
          "maximum": 16384
        },
        "public_access": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,29}$"
        },
        "dbs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,29}$"
          }
        }
      }
    },
    "db_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,29}/[a-z][a-z0-9-]{0,29}$"
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61})?[a-z0-9]$"
          }
        },
        "public_access": {
          "type": "boolean"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        },
        "apps": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/app"
          }
        },
        "functions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/function"
          }
        },
        "static_sites": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/static_site"
          }
        },
        "database": {
          "$ref": "#/$defs/database"
        },
        "databases": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/database"
          }
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "deploy": {
          "$ref": "#/$defs/deploy"
        },
        "terraform": {
          "$ref": "#/$defs/custom_terraform"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external": {
          "type": "boolean"
        },
        "target_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "exposed_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "transport": {
          "enum": [
            "auto",
            "http",
            "http2",
            "tcp"
          ]
        },
        "allow_insecure": {
          "type": "boolean"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?Gi$"
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "context": {
              "type": "string"
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "image",
              "docker"
            ]
          }
        }
      ]
    },
    "provider_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "random",
            "null",
            "tls",
            "time",
            "local",
            "external",
            "azuread",
            "azapi"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "custom_terraform": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dir"
          ],
          "properties": {
            "dir": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\.\\.).+$"
            },
            "providers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/provider_ref"
              }
            }
          }
        }
      ]
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Deploy policy for this stack: how the action should behave when shipping it. Per-environment overridable, which is the point -- these were workflow inputs, so they could not vary between dev and prod.",
      "properties": {
        "always_run_terraform": {
          "type": "boolean",
          "description": "Run Terraform on every deploy. When false, an unchanged manifest skips Terraform and the new image is rolled directly onto the existing container apps and functions."
        },
        "verify": {
          "type": "boolean",
          "description": "After deploying, check that the declared container apps and function apps exist and are healthy, failing the run when they are not."
        },
        "verify_timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "Seconds to wait for every resource to become healthy."
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "app",
          "apps"
        ]
      }
    },
    {
      "not": {
        "required": [
          "database",
          "databases"
        ]
      }
    }
  ]
}
